{
  "$schema": "https://json-schema.org/schema",
  "$id": "GenerateLib",
  "title": "Generate Lib Options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Package name, without the @ab-toolbox/ scope",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },
    "description": {
      "type": "string",
      "description": "One-line package description shown on npm",
      "x-prompt": "Short description for npm:"
    }
  },
  "required": ["name"]
}
