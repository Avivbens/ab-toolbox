{
  "name": "@ab-toolbox/grabvid",
  "version": "0.0.1",
  "description": "Download videos and HLS streams from pages that block yt-dlp, with an interactive quality picker and resumable downloads",
  "keywords": [
    "cli",
    "video",
    "hls",
    "m3u8",
    "downloader",
    "yt-dlp"
  ],
  "homepage": "https://github.com/Avivbens/ab-toolbox/tree/master/projects/libs/grabvid#readme",
  "bugs": {
    "url": "https://github.com/Avivbens/ab-toolbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avivbens/ab-toolbox.git",
    "directory": "projects/libs/grabvid"
  },
  "license": "MIT",
  "author": {
    "name": "Aviv Ben Shahar",
    "email": "avivbens87@gmail.com"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "grabvid": "./dist/main.js"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@inquirer/select": "^5.2.6",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {},
      "test": {},
      "lint": {},
      "serve": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "mkdir -p tmp && cd tmp && node ../dist/main.js",
          "tty": true
        },
        "continuous": true
      }
    }
  }
}
